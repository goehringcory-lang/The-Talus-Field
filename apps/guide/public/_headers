# Indexing. The gated app stays out of search through index.html's
# `noindex, nofollow`, which every app route is served. The storefront pages
# (/preview and the stop teasers) are separate prerendered files that say
# `index, follow` (scripts/prerender-public.ts), and only on the production
# host: the pages.dev hosts, the project's and every preview deployment's,
# are noindex for everything, so the old magic-link host never competes with
# guide.thetalusfieldjournal.com.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex

# The shell must revalidate on every load so a deploy reaches clients on
# their next visit; hashed /assets/* carry the real long-lived caching.
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts and brand marks never change without a rename; track JSONs carry a
# content-hash ?v= (TRACKS_VERSION) that turns the URL over on change. Without
# these, every cold launch revalidates four woff2 files and the logo over
# park LTE before the SW's runtime cache can help.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/brand/*
  Cache-Control: public, max-age=31536000, immutable

/tracks/*
  Cache-Control: public, max-age=31536000, immutable

# Photos keep stable names (no hash), so they get the editorial site's 30-day
# policy rather than immutable: a replaced photo is stale for at most a month.
/photos/*
  Cache-Control: public, max-age=2592000
