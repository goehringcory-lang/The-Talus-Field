# Files in the repo that should not be uploaded as public assets.
# Wrangler reads this when deploying Workers static assets.

# Version control and build internals
.git
.gitignore
.gitattributes
.githooks
.github
.wrangler
.claude

# Dev tooling, audits, and staged photos — never site content. Without these
# entries the whole scripts/ tree (generators, data, lockfiles) was fetchable
# on the production domain.
scripts
analysis
docs
photo-inbox

# Raw uploads staged under img/. The site serves the ingested, downscaled,
# metadata-stripped copies at img/<slug>.jpg; the originals here are camera and
# stock files that still carry their EXIF and cost ~36 MB of asset upload.
img/Photos

# Nature Notes markdown sources (the *.md rule below already catches them;
# named here so the directory can never leak a non-md file).
nature-notes

# Sub-projects with their own deployments
apps
workers
wrangler.jsonc

# Edge SEO Worker source (bundled via wrangler.jsonc `main`, not site content)
edge

# Root build-command shim for Cloudflare Workers Builds, not site content
package.json
package-lock.json

# Repo documentation
*.md
