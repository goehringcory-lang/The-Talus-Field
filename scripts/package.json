{
  "name": "the-talus-field-tools",
  "version": "1.0.0",
  "private": true,
  "description": "Dev-only tooling for the build-free editorial site. Lives in scripts/ (NOT the repo root) so Cloudflare Pages keeps treating the root as a static, build-free deploy. The site never depends on this at runtime. Run: cd scripts && npm install && npm run images",
  "scripts": {
    "images": "node gen-responsive-images.mjs",
    "brand": "node gen-brand-icons.mjs",
    "og": "node gen-og-cards.mjs",
    "photos": "node fetch-guide-photos.mjs",
    "photos:ingest": "node ingest-photos.mjs",
    "seo": "node gen-seo-artifacts.mjs",
    "seo:check": "node gen-seo-artifacts.mjs --check",
    "prerender": "node gen-prerender.mjs",
    "prerender:check": "node gen-prerender.mjs --check",
    "compile": "node gen-compiled.mjs",
    "compile:check": "node gen-compiled.mjs --check",
    "home-shell": "node gen-home-shell.mjs",
    "home-shell:check": "node gen-home-shell.mjs --check",
    "archive": "node gen-archive.mjs",
    "archive:check": "node gen-archive.mjs --check",
    "checks": "node system-checks.mjs",
    "checks:online": "node system-checks.mjs --online",
    "archive:citations": "node check-archive-citations.mjs",
    "assets:check": "node check-asset-freshness.mjs --verbose",
    "assets:stamp": "node check-asset-freshness.mjs --stamp",
    "photos:check": "node check-guide-photos.mjs --verbose",
    "intent:check": "node check-intent-tags.mjs --verbose",
    "bridge:check": "node check-trip-bridge.mjs --verbose",
    "api:check": "node system-checks.mjs --online --only=api",
    "check": "bash check-cache-busters.sh && node check-asset-freshness.mjs && bash check-seo-artifacts.sh && node gen-prerender.mjs --check && node gen-compiled.mjs --check && node gen-home-shell.mjs --check && node gen-archive.mjs --check && node check-archive-citations.mjs && node check-guide-photos.mjs && node check-intent-tags.mjs && node check-trip-bridge.mjs && npm --prefix ../apps/guide run --silent check:itineraries",
    "tracks": "node gen-hike-tracks.mjs",
    "itineraries:check": "npm --prefix ../apps/guide run --silent check:itineraries"
  },
  "devDependencies": {
    "@babel/core": "^8.0.0",
    "@babel/preset-env": "^8.0.0",
    "@babel/preset-react": "^8.0.0",
    "adm-zip": "^0.6.0",
    "pngjs": "^7.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shapefile": "^0.6.6",
    "sharp": "^0.34.5",
    "undici": "^8.7.0"
  },
  "dependencies": {
    "hyparquet": "^1.26.2",
    "hyparquet-compressors": "^1.1.1"
  }
}
