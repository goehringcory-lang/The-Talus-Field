BEGIN:VEVENT
UID:halfdome-preseason@dates.thetalusfieldjournal.com
DTSTAMP:20260905T000000Z
DTSTART;VALUE=DATE:20260301
DTEND;VALUE=DATE:20260401
RRULE:FREQ=YEARLY
SUMMARY:Yosemite: Half Dome preseason lottery
DESCRIPTION:Applications open March 1 and close March 31 on Recreation.gov.
  Results are emailed in mid-April. $10 per application plus $10 per person
  if you win. About 225 day-hiker permits a day. Source: https://www.nps.go
 v/yose/planyourvisit/hdpermits.htm. Verified 2026-09-05. The Talus Field\,
  https://thetalusfieldjournal.com/dates
URL:https://thetalusfieldjournal.com/dates
BEGIN:VALARM
ACTION:DISPLAY
DESCRIPTION:Yosemite: Half Dome preseason lottery
TRIGGER:-P1D
END:VALARM
END:VEVENT
