diff --git a/scripts/check-house-voice.mjs b/scripts/check-house-voice.mjs
new file mode 100644
index 0000000..78de672
--- /dev/null
+++ b/scripts/check-house-voice.mjs
@@ -0,0 +1,58 @@
+#!/usr/bin/env node
+//
+// House-voice guard: no em-dashes and no exclamation marks in reader-facing
+// copy. CLAUDE.md states the rule and every article routine repeats it, but
+// until this file nothing in `npm run check` enforced it, so a slip shipped
+// silently. Scans the article bodies, the catalog's titles and deks, and the
+// bulletin. Exits non-zero on the first offending file, listing each line.
+//
+// Usage: node check-house-voice.mjs [--verbose]
+
+import { readFileSync, readdirSync } from "node:fs";
+import path from "node:path";
+import { ROOT } from "./lib/catalog.mjs";
+
+const verbose = process.argv.includes("--verbose");
+const EM_DASH = /—/;
+// An exclamation mark that ends a sentence of prose: preceded by a word or
+// closing punctuation, followed by whitespace, a tag, a quote, or the end of
+// the line. Code never matches this shape (`!==`, `!x`, `x!.y`).
+const EXCLAIM = /[A-Za-z0-9)”’][!](?=[\s<"'”’)]|$)/;
+// Proper names the park itself prints with the mark; quoting them is not a
+// voice slip. Add a name here only when it is the printed title of a thing.
+const ALLOW = ["Welcome to Tuolumne!"];
+// Code comments in a .js source are not reader-facing.
+const isComment = (rel, line) => rel.endsWith(".js") && line.trim().startsWith("//");
+
+const targets = [
+  ...readdirSync(path.join(ROOT, "bodies"))
+    .filter((f) => f.endsWith(".jsx"))
+    .map((f) => path.join("bodies", f)),
+  "data.js",
+  "bulletin.json",
+];
+
+let bad = 0;
+for (const rel of targets) {
+  const lines = readFileSync(path.join(ROOT, rel), "utf8").split("\n");
+  const hits = [];
+  lines.forEach((raw, i) => {
+    if (isComment(rel, raw)) return;
+    const line = ALLOW.reduce((s, name) => s.split(name).join(""), raw);
+    if (EM_DASH.test(line)) hits.push(`${i + 1}: em-dash: ${raw.trim().slice(0, 100)}`);
+    if (EXCLAIM.test(line)) hits.push(`${i + 1}: exclamation: ${raw.trim().slice(0, 100)}`);
+  });
+  if (hits.length) {
+    bad += 1;
+    console.error(`house-voice: ${rel}`);
+    for (const h of hits) console.error(`  ${h}`);
+  } else if (verbose) {
+    console.log(`ok ${rel}`);
+  }
+}
+
+if (bad) {
+  console.error(`house-voice: ${bad} file(s) carry an em-dash or an exclamation mark in reader-facing copy.`);
+  process.exit(1);
+}
+console.log(`house-voice: ${targets.length} files clean.`);
