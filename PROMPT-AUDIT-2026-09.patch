diff --git a/scripts/refresh-candidates.mjs b/scripts/refresh-candidates.mjs
new file mode 100644
index 0000000..923f4cb
--- /dev/null
+++ b/scripts/refresh-candidates.mjs
@@ -0,0 +1,70 @@
+#!/usr/bin/env node
+//
+// Evergreen-refresh candidate table. The Wednesday refresh routine picks one
+// article per run by decay (age weighted by the body's density of perishable
+// facts) and inbound-link deficit; this script does that arithmetic from the
+// repo so the runbook reads a table instead of recounting sixty-odd bodies by
+// hand each run. The GitHub-side exclusions (open PRs, the last two runs'
+// picks) and the pick itself stay with the routine.
+//
+// Usage: node refresh-candidates.mjs [--all] [--json]
+//   --all   include excluded rows (recently touched, dated month editions)
+//   --json  machine-readable output
+//
+// Score = days since isoModified x (1 + perishable facts per 1,000 words),
+// plus a fixed bonus when no other body links to the article. Ties in the
+// runbook go to the oldest isoModified; the table is sorted that way.
+
+import { readFileSync, existsSync } from "node:fs";
+import path from "node:path";
+import { ROOT, loadDataJs } from "./lib/catalog.mjs";
+
+const PERISHABLE = [
+  /\$\s?\d/g,
+  /\b(19|20)\d{2}\b/g,
+  /\b(January|February|March|April|May|June|July|August|September|October|November|December)\b/g,
+  /\b(reservation|reservations|permit|permits|lottery|fee|fees|hours|shuttle|opens?|closes?|closed|through)\b/gi,
+  /\b(Tioga|Glacier Point Road|Wawona Road|Big Oak Flat|Hetch Hetchy Road|Highway 120|Highway 140|Highway 41)\b/g,
+];
+const RECENT_DAYS = 45;
+const NO_INBOUND_BONUS = 60;
+const DATED_EDITION = /^yosemite-in-[a-z]+-\d{4}$/;
+
+const { articles } = loadDataJs();
+const today = new Date();
+const bodies = new Map();
+for (const a of articles) {
+  const file = path.join(ROOT, "bodies", `${a.slug}.jsx`);
+  bodies.set(a.slug, existsSync(file) ? readFileSync(file, "utf8") : "");
+}
+
+const rows = articles.map((a) => {
+  const body = bodies.get(a.slug) || "";
+  const text = body.replace(/<[^>]+>/g, " ");
+  const words = Math.max(1, text.split(/\s+/).filter(Boolean).length);
+  const perishable = PERISHABLE.reduce((n, re) => n + (text.match(re) || []).length, 0);
+  const ageDays = Math.floor((today - new Date(a.isoModified || a.isoDate)) / 86400000);
+  const needle = `href="/articles/${a.slug}"`;
+  let inbound = 0;
+  for (const [slug, other] of bodies) if (slug !== a.slug) inbound += other.split(needle).length - 1;
+  const density = perishable / (words / 1000);
+  const score = ageDays * (1 + density / 10) + (inbound === 0 ? NO_INBOUND_BONUS : 0);
+  const excluded =
+    ageDays < RECENT_DAYS ? `touched ${ageDays}d ago` : DATED_EDITION.test(a.slug) ? "dated month edition" : null;
+  return { slug: a.slug, cat: a.cat, isoModified: a.isoModified, ageDays, words, perishable, inbound, score: Math.round(score), excluded };
+});
+
+rows.sort((x, y) => y.score - x.score || (x.isoModified < y.isoModified ? -1 : 1));
+const shown = process.argv.includes("--all") ? rows : rows.filter((r) => !r.excluded);
+
+if (process.argv.includes("--json")) {
+  console.log(JSON.stringify(shown, null, 2));
+} else {
+  console.log("score  age  perish  words  inbound  slug");
+  for (const r of shown) {
+    console.log(
+      `${String(r.score).padStart(5)}  ${String(r.ageDays).padStart(3)}  ${String(r.perishable).padStart(6)}  ${String(r.words).padStart(5)}  ${String(r.inbound).padStart(7)}  ${r.slug}${r.excluded ? `  (${r.excluded})` : ""}`,
+    );
+  }
+  console.log(`\n${shown.length} of ${rows.length} articles eligible; excluded = touched under ${RECENT_DAYS} days or a dated month edition.`);
+}
