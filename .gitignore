# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp
*~

# Dependencies and build output
node_modules/
dist/
# ...except the editorial site's committed precompiled JS at the repo root
# (a source-derived artifact like img/responsive, generated by
# scripts/gen-compiled.mjs), which the build-free static deploy serves directly.
!/dist/
!/dist/**

# Misc
*.log

# Local CDN mirror used by smoke tests (npm copies of unpkg.com assets)
_local_cdn/

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
.env*
!.env.example

# Photo candidates awaiting selection (fetch-guide-photos.mjs); selected
# photos land in apps/guide/public/photos/, candidates never ship.
scripts/data/photo-candidates/

# Camera originals staged for ingest-photos.mjs. Never committed: the ingest
# writes a stripped, downscaled JPEG into img/ or apps/guide/public/photos/,
# and the multi-MB original has no reason to enter git history.
photo-inbox/

# Capture GPS and timestamps harvested by ingest-photos.mjs before the
# re-encode strips them. Local-only by design — it is the metadata we
# deliberately keep out of the deployed originals.
scripts/data/photo-exif-log.json

# Cached USGS quad + terrain-tile downloads for scripts/gen-hike-tracks.mjs;
# regenerated on demand, never committed.
scripts/data/.trailcache/
